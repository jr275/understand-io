# Copy to .env.local and fill in. Nothing here is required to read the sample texts.

# PostgreSQL connection string. When unset, the app runs in local-only mode
# (settings, annotations and glosses stay in the browser).
DATABASE_URL=postgres://localhost:5432/gloss

# Server-side key for Together AI (OpenAI-compatible). Used for margin glosses,
# whole-text questions, embeddings for semantic search and server transcription.
# Users can also paste their own key in the app; it is sent per request and never stored.
TOGETHER_API_KEY=

# Model ids (defaults shown).
GLOSS_CHAT_MODEL=deepseek-ai/DeepSeek-V3.1
GLOSS_EMBED_MODEL=BAAI/bge-base-en-v1.5
GLOSS_WHISPER_MODEL=openai/whisper-large-v3

# Secret used to sign the anonymous reader cookie. Generate with: openssl rand -hex 32
GLOSS_COOKIE_SECRET=change-me

    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"

    "test:visual:update": "playwright test --project=visual --update-snapshots=all"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.142",

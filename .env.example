# Copy to .env.local and fill in. Nothing here is required to read the sample texts.

# PostgreSQL connection string. When unset, the app runs in local-only mode
# (settings, annotations and glosses stay in the browser).
DATABASE_URL=postgres://localhost:5432/gloss

# Server-side key for Together AI (OpenAI-compatible). Used for margin glosses,
# whole-text questions, embeddings for semantic search and server transcription.
# Users can also paste their own key in the app; it is sent per request and never stored.
TOGETHER_API_KEY=

# Optional rate limits for requests paid by TOGETHER_API_KEY (a reader's own key is not limited). Requests per
# window, per reader id and per client address; "off" disables one. In memory, so per process (see README).
# GLOSS_RATE_GLOSS=30
# GLOSS_RATE_SEARCH=60
# GLOSS_RATE_TRANSCRIBE=15
# GLOSS_RATE_WINDOW_SEC=3600

# Model ids (defaults shown).
GLOSS_CHAT_MODEL=deepseek-ai/DeepSeek-V3.1
GLOSS_EMBED_MODEL=BAAI/bge-base-en-v1.5
GLOSS_WHISPER_MODEL=openai/whisper-large-v3

# Secret used to sign the anonymous reader cookie. Generate with: openssl rand -hex 32
GLOSS_COOKIE_SECRET=change-me

# Optional: Google sign-in, so a library follows the reader across browsers. Create an OAuth 2.0
# "Web application" client in Google Cloud Console and add
#   <APP_URL>/api/auth/google/callback  (e.g. http://localhost:3100/api/auth/google/callback)
# as an authorised redirect URI. Without these the Sign in button explains that sign-in is off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used for the OAuth redirect (defaults to the request's own origin).
APP_URL=

# dependencies
/node_modules
/.pnp
.pnp.*
.pnpm-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts

# test output
/coverage
/playwright-report/
/test-results/

# environment and credentials (only the example file is tracked)
.env*
!.env.example
*.pem

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local data: database dumps and backups never belong in the repository
*.dump
/backups/
neon-rehearsal-*.txt

# infrastructure state and variables
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# vercel
.vercel

# operating system and editors
.DS_Store
.idea/

# git worktrees created for parallel agents
/.claude/worktrees/

# Neon CLI context (holds an organisation id): never commit
.neon
